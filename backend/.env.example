DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/research_intel

# ----------------------------------------------------------------------
# FREE LLM PROVIDER OPTIONS (Choose any one or leave empty for local NLP)
# ----------------------------------------------------------------------

# Option 1: Google Gemini API (100% FREE key from https://aistudio.google.com/)
GEMINI_API_KEY=

# Option 2: Groq Cloud API (100% FREE key from https://console.groq.com/ - Llama 3.3 70B)
GROQ_API_KEY=

# Option 3: OpenAI API Key (Paid API key)
OPENAI_API_KEY=

# Option 4: Ollama Local LLM (100% Free & Offline at http://localhost:11434/v1)
# Set LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1

# LLM Provider Selection: 'auto' (detects Gemini/Groq/OpenAI/Ollama), 'gemini', 'groq', 'openai', or 'ollama'
LLM_PROVIDER=auto

OPENALEX_API_URL=https://api.openalex.org/works
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
